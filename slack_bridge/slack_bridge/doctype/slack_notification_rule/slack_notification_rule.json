   "fieldname": "cb_main",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "document_type",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Document Type",
   "options": "DocType",
   "reqd": 1
  },
  {
   "default": "New Document",
   "description": "Value Change fires when a specific field changes. Date-based events are evaluated by the scheduler. Daily Digest sends each user one daily summary of the documents grouped on them. Custom only fires when triggered from code.",
   "fieldname": "event",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Send On",
   "options": "New Document\nSave\nSubmit\nCancel\nDelete\nValue Change\nDays Before\nDays After\nMinutes Before\nMinutes After\nDaily Digest\nMethod\nCustom",
   "reqd": 1
  },
  {
   "depends_on": "eval:doc.event=='Value Change'",
   "fieldname": "value_changed",
   "fieldtype": "Data",
   "label": "Field to Watch",
   "mandatory_depends_on": "eval:doc.event=='Value Change'"
  },
  {
   "depends_on": "eval:['Days Before','Days After','Minutes Before','Minutes After'].includes(doc.event)",
   "fieldname": "date_field",
   "fieldtype": "Data",
   "label": "Date Field",
   "mandatory_depends_on": "eval:['Days Before','Days After','Minutes Before','Minutes After'].includes(doc.event)"
  },
  {
   "default": "0",
   "depends_on": "eval:['Days Before','Days After','Minutes Before','Minutes After'].includes(doc.event)",
   "fieldname": "days_in_advance",
   "fieldtype": "Int",
   "label": "Days / Minutes Offset"
  },
  {
   "depends_on": "eval:doc.event=='Method'",
   "description": "Fires when this controller method runs on the document.",
   "fieldname": "method",
   "fieldtype": "Data",
   "label": "Method Name",
   "mandatory_depends_on": "eval:doc.event=='Method'"
  },
  {
   "depends_on": "eval:doc.event=='Daily Digest'",
   "description": "Field on the document that holds the user to notify — a Link to User (e.g. allocated_to), or owner / modified_by. Each user gets one DM listing their documents.",
   "fieldname": "digest_group_by",
   "fieldtype": "Data",
   "label": "Group By User Field",
   "mandatory_depends_on": "eval:doc.event=='Daily Digest'"
  },
  {
   "default": "08:00:00",
   "depends_on": "eval:doc.event=='Daily Digest'",
   "description": "Sent at the first hourly scheduler tick after this time (site timezone), once per day.",
   "fieldname": "digest_send_after",
   "fieldtype": "Time",
   "label": "Send After"
  },
  {
   "depends_on": "eval:doc.event=='Daily Digest'",
   "description": "Optional JSON filters applied when collecting documents. Example: {\"status\": \"Open\"}",
   "fieldname": "digest_filters",
   "fieldtype": "Code",
   "label": "Document Filters (JSON)",
   "options": "JSON"
  },
  {
   "fieldname": "last_digest_date",
   "fieldtype": "Date",
   "hidden": 1,
   "label": "Last Digest Date",
   "no_copy": 1,
   "read_only": 1
  },
  {
   "fieldname": "sb_condition",
   "fieldtype": "Section Break",
   "label": "Condition"
  },
  {
   "description": "Optional Python expression. Available: doc, frappe (safe subset), nowdate. Example: doc.grand_total > 10000",
   "fieldname": "condition",
   "fieldtype": "Code",
   "label": "Condition",
   "options": "PythonExpression"
  },
  {
   "fieldname": "sb_message",
   "fieldtype": "Section Break",
   "label": "Message"
  },
  {
   "default": "Simple",
   "description": "Simple renders one Jinja-templated message. Block Kit gives full control.",
   "fieldname": "message_mode",
   "fieldtype": "Select",
   "label": "Message Mode",
   "options": "Simple\nBlock Kit"
  },
  {
   "depends_on": "eval:doc.message_mode=='Simple'",
   "description": "Jinja. Rendered as a bold header line. Example: New Order {{ doc.name }}",
   "fieldname": "subject",
   "fieldtype": "Data",
   "label": "Headline"
  },
  {
   "depends_on": "eval:doc.message_mode=='Simple'",
   "description": "Jinja + Slack mrkdwn. Available: doc, frappe (safe subset), nowdate, doc_url. Daily Digest rules instead get: docs, count, user, doc_url (list view).",
   "fieldname": "message",
   "fieldtype": "Code",
   "label": "Message",
   "options": "Jinja"
  },
  {
   "depends_on": "eval:doc.message_mode=='Block Kit'",
   "description": "Jinja that must render to a Block Kit JSON array.",
   "fieldname": "blocks_template",
   "fieldtype": "Code",
   "label": "Blocks Template",
   "mandatory_depends_on": "eval:doc.message_mode=='Block Kit'",
   "options": "Jinja"
  },
  {
   "default": "1",
   "depends_on": "eval:doc.message_mode=='Simple'",
   "fieldname": "attach_document_link",
   "fieldtype": "Check",
   "label": "Add Link to Document"
  },
  {
   "depends_on": "eval:doc.event!='Daily Digest'",
