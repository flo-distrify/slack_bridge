   "description": "Thread/Update keep all events for one document together in Slack.",
   "fieldname": "thread_mode",
   "fieldtype": "Select",
   "label": "Threading",
   "options": "New Message\nThread Under First Message\nUpdate Previous Message"
  },
  {
   "fieldname": "cb_delivery",
